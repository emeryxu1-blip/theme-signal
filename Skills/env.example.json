{
  "active_profiles": {
    "llm": "local",
    "quote": "local"
  },
  "llm_profiles": {
    "local": {
      "description": "Office-WiFi LiteLLM/OpenAI-compatible gateway for local workflow runs.",
      "provider": "litellm_openai_compatible",
      "api_key": "<OFFICE_WIFI_LITELLM_API_KEY>",
      "key_alias": "<OFFICE_WIFI_KEY_ALIAS>",
      "base_url": "https://aimemodeldev.myhexin.com/litellm",
      "default_model": "gpt-5.6-sol",
      "timeout_seconds": 600,
      "reasoning_effort": "low",
      "max_completion_tokens": 8000,
      "trace_header": "X-Trace-Id",
      "verify_tls": true,
      "source_instructions": "../API-Key-Officewifi/sdk.md",
      "protocols": {
        "models": "models",
        "chat_completions": "v1/chat/completions",
        "messages": "v1/messages"
      },
      "request": {
        "method": "POST",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer "
      }
    },
    "claude": {
      "description": "Optional explicit Anthropic profile; it is not the workflow default.",
      "provider": "anthropic",
      "api_key": "<ANTHROPIC_API_KEY>",
      "key_alias": "<ANTHROPIC_KEY_ALIAS>",
      "base_url": "https://api.anthropic.com",
      "messages_path": "/v1/messages",
      "models_path": "/v1/models",
      "model": "claude-opus-4-8",
      "timeout_seconds": 600,
      "max_completion_tokens": 8000,
      "verify_tls": true,
      "request": {
        "method": "POST",
        "auth_header": "x-api-key",
        "version_header": "anthropic-version: 2023-06-01",
        "thinking": {
          "type": "adaptive"
        }
      }
    },
    "production": {
      "description": "Production company LiteLLM/OpenAI-compatible gateway.",
      "provider": "litellm_openai_compatible",
      "api_key": "<PRODUCTION_LITELLM_API_KEY>",
      "key_alias": "<PRODUCTION_KEY_ALIAS>",
      "active_environment": "internal_equ",
      "default_model": "gpt-5.6-sol",
      "timeout_seconds": 600,
      "reasoning_effort": "low",
      "max_completion_tokens": 8000,
      "trace_header": "X-Trace-Id",
      "source_instructions": "../API-Key-Officewifi/sdk.md",
      "protocols": {
        "models": "models",
        "chat_completions": "v1/chat/completions",
        "messages": "v1/messages"
      },
      "environments": {
        "office_wifi": {
          "base_url": "https://aimemodeldev.myhexin.com/litellm"
        },
        "internal_equ": {
          "base_url": "https://internal-idc-equ.ainvest.com/ind/iwc-aime-model/litellm"
        },
        "overseas_prod": {
          "base_url": "http://iwc-aime-model:9219/litellm"
        }
      },
      "request": {
        "auth_header": "Authorization",
        "auth_prefix": "Bearer "
      }
    }
  },
  "quote_profiles": {
    "local": {
      "scene": "c",
      "auth": {
        "header": "Cookie",
        "cookie_value_template": "sessionid={sessionid}; userid={userid}",
        "login": {
          "auto_login": true,
          "email": "<AINVEST_ACCOUNT_EMAIL_OR_USERNAME>",
          "password": "<AINVEST_ACCOUNT_PASSWORD>",
          "password_signing_key_file": "Skills/ainvest-password-signing-key.pem",
          "verify_tls": true,
          "timeout_seconds": 20
        }
      },
      "sessionid": "<REFRESHED_SESSION_ID>",
      "userid": "<REFRESHED_USER_ID>",
      "endpoints": {
        "snapshot": "https://extquote.ainvest.com/index_api/indicator/v2/snapshot",
        "series": "https://extquote.ainvest.com/index_api/indicator/v2/series",
        "relation_list": "https://extquote.ainvest.com/index_api/relation/v1/list",
        "multi_kline": "https://quote.ainvest.com/quote/v2/multi_kline",
        "single_tick": "https://quote.ainvest.com/quote/v2/single_tick"
      }
    },
    "production": {
      "scene": "b",
      "auth": {
        "header": "apikey"
      },
      "credentials": {
        "index_api_apikey": "<INDEX_API_KEY>",
        "quoteag_apikey": "<QUOTEAG_API_KEY>"
      },
      "endpoints": {
        "snapshot": "http://quote-apisix-gateway.hxapisix/index_api/indicator/v2/snapshot",
        "series": "http://quote-apisix-gateway.hxapisix/index_api/indicator/v2/series",
        "relation_list": "http://quote-apisix-gateway.hxapisix/index_api/relation/v1/list",
        "multi_kline": "http://quote-apisix-gateway.hxapisix/quote/v2/multi_kline",
        "single_tick": "http://quote-apisix-gateway.hxapisix/quote/v2/single_tick"
      }
    }
  },
  "default_headers": {
    "Content-Type": "application/json",
    "Accept-Language": "en",
    "X-Auth-ProgId": "7080"
  }
}
